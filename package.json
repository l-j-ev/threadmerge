{
  "name": "threadmerge",
  "version": "0.1.0",
  "private": true,
  "description": "ThreadMerge — Outlook add-in for merging email threads with controlled disclosure",
  "scripts": {
    "dev:addin": "pnpm --filter @threadmerge/addin dev",
    "dev:dashboard": "pnpm --filter @threadmerge/dashboard dev",
    "dev:backend": "pnpm --filter @threadmerge/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
