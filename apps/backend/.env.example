# Database connection (Azure Postgres Flexible Server)
DATABASE_URL="postgresql://threadmergeadmin:YOUR_DB_PASSWORD@YOUR_SERVER.postgres.database.azure.com:5432/threadmerge?sslmode=require"

# Azure AD App Registration (multi-tenant)
AZURE_CLIENT_ID=your-application-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Server config
PORT=4000
NODE_ENV=development

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3001
